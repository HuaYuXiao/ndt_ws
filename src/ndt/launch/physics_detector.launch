<launch>
  <!-- 基于物理约束注意力机制的接触检测节点 -->
  <node pkg="ndt" type="physics_constrained_detector.py" name="physics_constrained_detector"
        output="screen" cwd="node">
    <!-- topics -->
    <param name="depth_topic"         value="/d435/aligned_depth_to_color/image_raw" />
    <param name="camera_info_topic"   value="/d435/color/camera_info" />
    <param name="pose_topic"          value="/mavros/local_position/pose" />
    <param name="click_topic"         value="/rviz/click_point" />
    <param name="normal_topic"        value="/ndt_normal/target_pose_d435" />
    <param name="output_topic"        value="/ndt/contact_probability" />

    <!-- model -->
    <param name="window_size"         value="64" />
    <param name="roi_size"            value="20" />
    <param name="lambda_phys"         value="0.5" />
    <param name="d_model"             value="128" />
    <!-- model_path 必须指向训练好的 .pth 权重文件，否则节点无法启动 -->
    <param name="model_path"          value="$(find ndt)/runs/3/contact_detector_best.pt" />
  </node>
</launch>
