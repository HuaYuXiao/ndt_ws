<?xml version="1.0"?>
<package format="2">
  <name>record</name>
  <version>1.0.0</version>
  <description>
    Multi-modal data recorder for EMAT contact detection experiments.
    Synchronously records EMAT waveforms, drone pose, RGB-D video, and flight setpoints.
  </description>
  <maintainer email="cwkj@example.com">cwkj</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>message_runtime</depend>
  <build_depend>emat</build_depend>
  <exec_depend>emat</exec_depend>
</package>
