<launch> 
    <include file="$(find mavros)/launch/px4.launch" />
    
    <include file="$(find livox_ros_driver2)/launch/msg_MID360.launch" />

    <include file="$(find fast_lio)/launch/mapping_mid360.launch" />

    <node name='lidar_to_mavros' pkg="bringup" type="lidar_to_mavros.py" output="screen" />
    
    <include file="$(find realsense2_camera)/launch/rs_camera.launch" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_d435" args="0.07 0 -0.025 0 0 0 1 base_link d435_link" />

    <node name="emat" pkg="emat" type="emat_waveform_node" output="screen">
        <!-- 官方"平均次数=4"软件复刻(滑动窗口): 1s节奏采集, 每帧用最近4帧对齐平均 -> 1s发布1帧.
             节奏须>=1s: 500ms与设备内部周期混叠产生噪声帧(实测1-2s 100%干净, 厂商软件为2s) -->
        <param name="read_interval_ms" value="1000" />
        <param name="waveform_average_n" value="4" />
        <param name="chunk_delay_ms" value="30" />
        <param name="read_timeout_ms" value="500" />
        <param name="max_startup_retries" value="30" />
        <param name="max_consecutive_failures" value="5" />
        <param name="reconnect_delay_s" value="3" />
    </node>
    
  <node pkg="emat" type="emat_feature_extractor.py" name="emat_feature_extractor"
        output="screen" cwd="node">
    <!-- topics -->
    <param name="waveform_topic" value="/emat/waveform" />
    <param name="features_topic" value="/emat/features" />

    <!-- detection -->
    <param name="arrival_threshold" value="0.1" />
    <param name="speed_of_sound" value="3240.0" />

    <!-- waveform geometry -->
    <param name="sampling_rate" value="40000000.0" />
    <param name="slice_start" value="300" />
    <param name="slice_end" value="2000" />

    <!-- envelope lowpass filter -->
    <param name="lp_cutoff" value="10.0" />
    <param name="lp_order" value="4" />
  </node>

  <node pkg="emat" type="emat_thickness_node.py" name="emat_thickness" output="screen">
    <!-- topics -->
    <param name="waveform_topic" value="/emat/waveform" />
    <param name="thickness_topic" value="/emat/thickness" />

    <!-- autocorrelation thickness estimation -->
    <param name="sampling_rate" value="40000000.0" />
    <param name="speed_of_sound" value="3230.0" />
    <param name="fallback_slice_start" value="300" />
    <param name="slice_end" value="1500" />
    <param name="envelope_window_samples" value="30" />
    <param name="env_noise_floor" value="20.0" />

    <!-- 自适应 slice_start: 不同试件激励残留范围不同, 动态检测余振结束位置,
         找不到静默间隙时回退上面的固定 fallback_slice_start -->
    <param name="adaptive_slice_start" value="true" />
    <param name="excitation_noise_mult" value="4.0" />
    <param name="excitation_hang_samples" value="80" />
    <param name="excitation_guard_margin" value="20" />
    <param name="slice_start_min" value="200" />
    <param name="slice_start_max" value="800" />
    <!-- 薄件二次搜索下界: 4mm回波间隔~99样本会被默认下界100挡掉 -->
    <param name="lag_lo_thin" value="40" />
    <!-- 弱回波区下限: 实测弱回波串16-18.5, 纯噪声帧<5 -->
    <param name="env_weak_floor" value="10.0" />
  </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_actuator" args="0.435 -0.05 -0.16 0 0 0 1 base_link actuator_link" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_dummyactuator" args="0.725 -0.05 -0.16 0 0 0 1 base_link dummyactuator_link" />

    <node launch-prefix="bash -c '{ sleep 2 &amp;&amp; xdotool search --name RViz windowmaximize --sync; } &amp; exec $0 $@' " pkg="rviz" type="rviz" name="rviz" args="-d $(find bringup)/config/rviz.rviz" />
</launch>
