<?xml version="1.0"?>
<package format="2">
  <name>emat</name>
  <version>1.1.0</version>
  <description>
    EMAT electromagnetic acoustic transducer thickness gauge ROS driver.
    Publishes ultrasonic waveform data and thickness measurements from
    CH346 USB-based EMAT probe.
  </description>
  <maintainer email="cwkj@example.com">cwkj</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>rviz</depend>
  <depend>pluginlib</depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml" />
  </export>
</package>
