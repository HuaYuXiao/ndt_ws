
# XeLaTeX + BibTeX full pipeline for thesis-uestc
$pdf_mode = 5;                                  # xelatex mode
$xelatex = "xelatex -synctex=1 -interaction=nonstopmode %O %S";
$bibtex = "bibtex %O %B";
$bibtex_use = 2;                                # always run bibtex when bib files change
$clean_ext .= " %R.ist %R.xdv %R.run.xml %R.synctex.gz";
$max_repeat = 5;                                # allow up to 5 passes for cross-refs + bookmarks
$force_mode = 1;                                # ignore xelatex exit code 1 (cover page error)

push @generated_exts, 'glo', 'gls', 'glg';
push @generated_exts, 'acn', 'acr', 'alg';

add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');

sub run_makeglossaries {
    if ($silent) {
        system "makeglossaries -q $_[0]";
    } else {
        system "makeglossaries $_[0]";
    };
}

# thesis-uestc: run bibtex on accomplish.aux (generated by \thesisaccomplish)
# latexmk doesn't know about this extra aux file, so we hook into xelatex's
# success callback to run it after every pass
$success_cmd = 'run_accomplish_bibtex';
sub run_accomplish_bibtex {
    if (-e "accomplish.aux") {
        print "=== Running bibtex on accomplish.aux ===\n";
        system("bibtex accomplish");
    }
}
